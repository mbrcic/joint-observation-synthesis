> Copy to `lakefile.toml` and replace `<EXACT_ATLAS_COMMIT>` with a full 40-character
> Atlas commit. Kept as a template so an unresolvable placeholder revision cannot break a
> build or a CI run.

name = "joint-observation-synthesis"
version = "0.0.1"
defaultTargets = ["JointObservationSynthesis"]

[leanOptions]
warningAsError = true

[[require]]
name = "ai-safety-formalization-atlas"
git = "https://github.com/mbrcic/ai-safety-formalization-atlas.git"
rev = "<EXACT_ATLAS_COMMIT>"

[[lean_lib]]
name = "JointObservationSynthesis"
