# Copy to `.env` in this directory and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#   $EDITOR .env

# OpenRouter — used by `--agent openrouter`.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: default model handle for --agent openrouter.
# Overridden by --model on the command line.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Anthropic — used by `--agent claude`. Optional; the SDK also reads this from
# the ambient environment or an `ant auth login` profile.
# ANTHROPIC_API_KEY=
